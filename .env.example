NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase configuration (optional for DEMO_MODE=true)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only service role key for administrative operations (optional)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Set to true for offline demo mode with deterministic simulated responses
DEMO_MODE=true
